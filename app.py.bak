from flask import Flask, render_template, request, jsonify
from backend.hybrid_decision import predict_combined

@app.route("/predict", methods=["GET", "POST"])
def predict():
    if request.method == "POST":
        features = request.get_json()
        result = predict_combined(features)

        # --- Defensive: write prediction into detections table for history/dashboard ---
        try:
            conn = get_db()
            cur = conn.cursor()
            created_at = datetime.datetime.utcnow().isoformat()
            traffic_id = features.get("traffic_id") or features.get("sid") or features.get("src_ip") or features.get("src") or None
            model_used = result.get("model") or "hybrid"
            prediction = None
            try:
                # try common locations
                prediction = result.get("prediction") or (result.get("xgb") or {}).get("prediction") or result.get("dqn_label")
            except Exception:
                prediction = str(result.get("prediction", ""))
            dqn_action = result.get("dqn_action") or result.get("action") or None
            final_score = float(result.get("final_score") or result.get("anomaly_score") or 0.0)
            should_honeypot = 1 if result.get("should_honeypot") else 0
            raw = json.dumps(result, default=str)

            cur.execute("""
                INSERT INTO detections (created_at, traffic_id, model_used, prediction, dqn_action, final_score, should_honeypot, raw)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (created_at, traffic_id, model_used, str(prediction), dqn_action, final_score, should_honeypot, raw))
            try:
                safe_commit(conn)
            except Exception:
                conn.commit()
            conn.close()
        except Exception as e:
            app.logger.warning("Could not persist detection: %s", e)

        return jsonify(result)
    return render_template("predict.html")
@app.route("/admin/log_prediction", methods=["POST"])
def admin_log_prediction():
    try:
        payload = request.get_json() or {}
        ts = payload.get("timestamp") or datetime.datetime.utcnow().isoformat()
        prediction = payload.get("prediction") or payload.get("raw") or {}
        dqn_action = payload.get("dqn_action") or payload.get("action")
        final_score = float(payload.get("final_score") or payload.get("score") or 0)
        should_honeypot = 1 if payload.get("should_honeypot") else 0
        raw = json.dumps(payload.get("raw") or payload or {}, default=str)

        conn = get_db()
        cur = conn.cursor()
        cur.execute("""
            INSERT INTO detections (created_at, traffic_id, model_used, prediction, dqn_action, final_score, should_honeypot, raw)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (ts, payload.get("traffic_id") or payload.get("sid") or None, payload.get("model_used") or "ui", str(prediction), dqn_action, final_score, should_honeypot, raw))
        try:
            safe_commit(conn)
        except Exception:
            conn.commit()
        conn.close()
    except Exception as e:
        app.logger.warning("admin_log_prediction failed: %s", e)
    return jsonify({"ok": True})

