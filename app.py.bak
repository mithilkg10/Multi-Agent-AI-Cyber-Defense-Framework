        # Prefer detections table if it exists
        try:
            cur.execute("SELECT id, created_at, traffic_id, model_used, prediction, dqn_action, final_score, should_honeypot FROM detections ORDER BY id DESC LIMIT ?", (limit,))
            rows = [dict(r) for r in cur.fetchall()]
            conn.close()
            out = []
            for r in rows:
                out.append({
                    "id": r.get("id"),
                    "traffic_id": r.get("traffic_id"),
                    "model_used": r.get("model_used"),
                    "prediction": r.get("prediction"),
                    "final_score": r.get("final_score"),
                    "dqn_action": r.get("dqn_action"),
                    "timestamp": r.get("created_at")
                })
            return jsonify(out)
        except sqlite3.OperationalError:
            conn.close()
            return jsonify([])
    except Exception as e:
        app.logger.error("admin_detections_json error: %s", e)
        return jsonify({"error":"server error","detail":str(e)}), 500


@app.route("/admin/registration_requests_json")
def admin_registration_requests_json():
    """
    Return only requests with status 'pending' (or NULL) for admin dashboard.
    """
    try:
        limit = int(request.args.get("limit", 50))
    except:
        limit = 50
    try:
        conn = _safe_get_db_conn(); cur = conn.cursor()
        # Return only pending ones to avoid counting already approved/rejected requests
        cur.execute("SELECT * FROM registration_requests WHERE status='pending' OR status IS NULL ORDER BY id DESC LIMIT ?", (limit,))
        rows = [dict(r) for r in cur.fetchall()]
        conn.close()
        return jsonify(rows)
    except sqlite3.OperationalError:
        try:
            conn.close()
        except:
            pass
        return jsonify([])
    except Exception as e:
        app.logger.error("registration_requests_json error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500


@app.route("/admin/insert_fake_registrations", methods=["POST"])
def admin_insert_fake_registrations():
    try:
        n = int(request.args.get("n", 8))
    except:
        n = 8
    try:
        conn = _safe_get_db_conn(); cur = conn.cursor()
        try:
            cols = [c["name"] for c in cur.execute("PRAGMA table_info(registration_requests)").fetchall()]
        except sqlite3.OperationalError:
            cols = []
        if not cols:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS registration_requests (
                  id INTEGER PRIMARY KEY AUTOINCREMENT,
                  full_name TEXT,
                  department TEXT,
                  remarks TEXT,
                  status TEXT DEFAULT 'pending',
                  created_at TEXT
                )
            """)
            conn.commit()
            cols = [c["name"] for c in cur.execute("PRAGMA table_info(registration_requests)").fetchall()]
        inserted = 0
        for i in range(n):
            now = datetime.datetime.utcnow().isoformat()
            row = {}
            if "full_name" in cols:
                row["full_name"] = "demo_user_" + ''.join(random.choices(string.ascii_uppercase, k=4))
            if "department" in cols:
                row["department"] = random.choice(["ise","cse","ece","mech"])
            if "remarks" in cols:
                row["remarks"] = "Please grant demo access " + str(i+1)
            if "status" in cols:
                row["status"] = "pending"
            if "created_at" in cols:
                row["created_at"] = now
            keys = list(row.keys())
            vals = [row[k] for k in keys]
            if keys:
                sql = "INSERT INTO registration_requests (" + ",".join(keys) + ") VALUES (" + ",".join(["?"]*len(keys)) + ")"
                cur.execute(sql, vals)
                inserted += 1
        conn.commit()
        conn.close()
        return jsonify({"message": f"Inserted {inserted} fake registration rows"}), 200
    except Exception as e:
        app.logger.error("insert_fake_registrations error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

# ------------------ safer DB helper ------------------
def get_db():
    conn = sqlite3.connect(DB_NAME, timeout=30, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    try:
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
        conn.execute("PRAGMA busy_timeout = 5000;")
    except Exception as e:
        print("⚠️ Could not set PRAGMAs:", e)
    return conn

# -------------------- Init DB & default admin --------------------
def init_db():
    conn = get_db()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            role TEXT DEFAULT 'analyst',
            last_login TIMESTAMP,
            failed_attempts INTEGER DEFAULT 0,
            locked_until TIMESTAMP
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS login_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            login_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            ip_address TEXT,
            status TEXT,
            FOREIGN KEY(user_id) REFERENCES users(id)
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS registration_requests (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            full_name TEXT,
            department TEXT,
            remarks TEXT,
            status TEXT DEFAULT 'pending',
            created_at TEXT
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS admins (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE,
            password TEXT,
            full_name TEXT,
            last_login TEXT
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS login_log_stream (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT,
            ip_address TEXT,
            event TEXT,
            timestamp TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS captures (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            capture_id TEXT,
            requested_by TEXT,
            iface TEXT,
            bpf_filter TEXT,
            filename TEXT,
            started_at TEXT,
            stopped_at TEXT,
            status TEXT
        )
    """)

    # blocklist table (create if missing)
    try:
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS blocklist (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ip_address TEXT,
                ip TEXT,
                ip_addr TEXT,
                ipaddr TEXT,
                ip_entry TEXT,
                ip_column TEXT,
                ip_col TEXT,
                expires_at TEXT,
                reason TEXT,
                created_at TEXT,
                active INTEGER DEFAULT 1
            )
        """)
    except Exception:
        pass
        # detections table (stores model predictions & RL action history)
    try:
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS detections (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT,
                traffic_id TEXT,
                model_used TEXT,
                prediction TEXT,
                dqn_action TEXT,
                final_score REAL,
                should_honeypot INTEGER,
                raw TEXT
            )
        """)
    except Exception:
        pass


    conn.commit()

    # ------------------ SAFE AUTO-SEED: Insert sample IP login rows if login_log empty ------------------
     # ------------------ SAFE AUTO-SEED: Insert sample IP login rows if login_log empty ------------------
    try:
        cur2 = conn.cursor()
        cur2.execute("SELECT COUNT(1) AS cnt FROM login_log")
        row = cur2.fetchone()
        cnt = int(row["cnt"]) if row and "cnt" in row.keys() else 0

        if cnt == 0:
            # Insert 12 sample login rows: mix of Indian prefixes & foreign IPs, spaced hourly
            now = datetime.datetime.utcnow().replace(minute=0, second=0, microsecond=0)
            sample_ips = [
                "103.21.45.12", "49.36.120.5", "14.139.23.77", "117.197.22.5",
                "192.168.1.34",   # local
                "8.8.8.8", "34.201.45.10", "13.59.78.16", "203.0.113.5", "45.77.34.2",
                "223.25.10.12", "144.91.76.21"
            ]
            for i, ip in enumerate(sample_ips):
                ts = (now - datetime.timedelta(hours=(len(sample_ips)-i))).isoformat()
                cursor.execute("INSERT INTO login_log (user_id, login_time, ip_address, status) VALUES (?, ?, ?, ?)",
                               (None, ts, ip, "success"))
            conn.commit()
            print("✅ Seeded sample login_log rows for Live IP charts (1st-run).")
    except Exception as e:
        print("⚠️ sample seeding error (non-fatal):", e)

    conn.close()

def create_default_admin():
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM admins WHERE username='admin'")
    if not cursor.fetchone():
        cursor.execute(
            "INSERT INTO admins (username, password, full_name) VALUES (?, ?, ?)",
            ("admin", "Admin@123", "System Administrator")
        )
        conn.commit()
        print("✅ Default admin created: admin / Admin@123")
    conn.close()

# -------------------- Utility functions --------------------
def log_login_attempt(user_id, status):
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("INSERT INTO login_log (user_id, ip_address, status) VALUES (?, ?, ?)",
                       (user_id, request.remote_addr, status))
        conn.commit()
    except sqlite3.OperationalError as e:
        print(f"⚠️ log_login_attempt DB locked/err: {e}")
    finally:
        try: conn.close()
        except: pass

def log_login_attempt_unknown(username, status):
    try:
        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO login_log (user_id, ip_address, status)
            VALUES (NULL, ?, ?)
        """, (request.remote_addr, f"{status} (unknown user: {username})"))
        conn.commit()
    except sqlite3.OperationalError as e:
        print(f"⚠️ log_login_attempt_unknown DB locked/err: {e}")
    finally:
        try: conn.close()
        except: pass

# -------------------- Authentication checks --------------------
def check_user(username, password):
    conn = get_db()
    cursor = conn.cursor()

    cursor.execute("SELECT * FROM admins WHERE username=?", (username,))
    admin = cursor.fetchone()
    if admin:
        if admin["password"] == password:
            cursor.execute("UPDATE admins SET last_login=? WHERE id=?", 
                           (datetime.datetime.now().isoformat(), admin["id"]))
            conn.commit()
            conn.close()
            return {"username": admin["username"], "role": "admin"}
        conn.close()
        return None

    cursor.execute("SELECT * FROM users WHERE username=?", (username,))
    user = cursor.fetchone()
    if user:
        if user["password"] == password:
            cursor.execute("UPDATE users SET last_login=? WHERE id=?", 
                           (datetime.datetime.now().isoformat(), user["id"]))
            conn.commit()
            conn.close()
            return {"username": user["username"], "role": "user"}
        conn.close()
        return None

    conn.close()
    return None

############################ anomaly detector Begin ################
def start_anomaly_detector():
    import subprocess, sys, os
    try:
        flags = 0
        if os.name == 'nt' and hasattr(subprocess, "CREATE_NO_WINDOW"):
            flags = subprocess.CREATE_NO_WINDOW
        subprocess.Popen([sys.executable, "anomaly_detector.py"], creationflags=flags)
        print("🔎 Anomaly detector started in background.")
    except Exception as e:
        print("⚠️ Could not start anomaly detector:", e)

# -------------------- Kafka consumer (background) --------------------
def start_kafka_consumer(bootstrap_servers=None, topic='network-traffic', group_id='cyber-defense-group'):
    import threading, time, json, datetime, os, sqlite3
    from kafka import KafkaConsumer

    if bootstrap_servers is None:
        bootstrap_servers = ['localhost:9092']

    ALLOWED_LOGIN_EVENTS = {"login_success", "login_fail", "login_attempt"}

    def consume():
        backoff = 1.0
        while True:
            try:
                consumer = KafkaConsumer(
                    topic,
                    bootstrap_servers=bootstrap_servers,
                    auto_offset_reset='latest',
                    enable_auto_commit=True,
                    group_id=group_id,
                    value_deserializer=lambda x: x
                )
                print("✅ Background Kafka Consumer started...")
            except Exception as e:
                print(f"⚠️ Kafka consumer init failed: {e}. Retrying in {backoff}s...")
                time.sleep(backoff)
                backoff = min(backoff * 1.8, 30.0)
                continue

            backoff = 1.0
            print("Kafka consumer cwd:", os.getcwd())
            print("Kafka consumer DB path:", os.path.abspath(DB_NAME))

            try:
                t0 = time.time()
                while not consumer.assignment() and (time.time() - t0) < 3.0:
                    consumer.poll(timeout_ms=100)
                    time.sleep(0.05)
                for tp in consumer.assignment():
                    consumer.seek_to_end(tp)
                print("🔚 Kafka consumer: seeked to END (ignoring old backlog).")
            except Exception as e:
                print("⚠️ Could not seek to end:", e)

            try:
                for message in consumer:
                    raw = message.value
                    data = None
                    try:
                        if raw is None:
                            raise ValueError("Empty Kafka message value")
                        if isinstance(raw, bytes):
                            s = raw.decode('utf-8', errors='strict')
                        else:
                            s = str(raw)
                        if not s.strip():
                            raise ValueError("Blank message")
                        data = json.loads(s)
                    except Exception as decode_err:
                        print(f"⚠️ Kafka decode failed: {repr(raw)} -> {decode_err}")
                        continue

                    username = data.get("username", "unknown")
                    ip = data.get("ip", data.get("ip_address", "unknown"))
                    event = data.get("event", "").lower()
                    timestamp = data.get("timestamp", datetime.datetime.now().isoformat())

                    if event not in ALLOWED_LOGIN_EVENTS:
                        print(f"⏭️ Skipped non-login event: {event}")
                        continue

                    try:
                        conn = get_db()
                        cursor = conn.cursor()
                        cursor.execute("""
                            INSERT INTO login_log_stream (username, ip_address, event, timestamp)
                            VALUES (?, ?, ?, ?)
                        """, (username, ip, event, timestamp))
                        try:
                            safe_commit(conn)
                        except Exception:
                            conn.commit()

                        print(f"🟢 Kafka consumer inserted LOGIN event -> {username} | {event}")
                    except sqlite3.OperationalError as e:
                        print("⚠️ DB locked, skipping write:", e)
                    except Exception as e:
                        print("❌ DB write error:", e)
                    finally:
                        try: conn.close()
                        except: pass

            except Exception as e:
                print(f"⚠️ Consumer crash inside loop, restarting: {e}")
                try: consumer.close()
                except: pass
                time.sleep(1)
                continue

    thread = threading.Thread(target=consume, daemon=True)
    thread.start()
    return thread

import time

def safe_commit(conn, retries=5):
    for i in range(retries):
        try:
            conn.commit()
            return
        except sqlite3.OperationalError as e:
            if "database is locked" in str(e).lower():
                print(f"⚠️ Database locked, retrying... ({i+1}/{retries})")
                time.sleep(0.5)
            else:
                raise
    raise Exception("❌ Database still locked after multiple retries")

####################################################################################  t shark global functions (testing integration)
def _start_tshark_capture_process(capture_id, iface, bpf, out_file):
    cmd = ['tshark', '-i', iface, '-w', out_file]
    if bpf:
        cmd = ['tshark', '-i', iface, '-f', bpf, '-w', out_file]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return proc
@app.route("/live_packets")
def live_packets():
    def generate():
        while True:
            sample = {
                "packet_rate": random.randint(20, 200),
                "entropy": round(random.uniform(0.2, 0.95), 2),
                "syn_flag": random.choice([0,1]),
                "ttl": random.randint(30, 128),
                "dst_port": random.choice([22, 80, 443, 3389])
            }
            yield f"data: {json.dumps(sample)}\n\n"
            time.sleep(1)  # 1 packet/sec
    return Response(generate(), mimetype="text/event-stream")

def _pcap_reader_streamer(capture_id, out_file, q, stop_event):
    try:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
    except Exception as e:
        q.put({"time":"", "src":"", "dst":"", "proto":"ERROR", "info": f"loop_setup_error: {e}"})

    last_index = 0
    last_error = None
    last_error_time = 0.0
    try:
        while not stop_event.is_set():
            try:
                cap = pyshark.FileCapture(out_file, keep_packets=False)
                idx = 0
                for pkt in cap:
                    if idx >= last_index:
                        try:
                            ts = getattr(pkt, "sniff_time", None)
                            ts_s = ts.isoformat() if ts else ""
                        except Exception:
                            ts_s = ""
                        try:
                            proto = getattr(pkt, "highest_layer", "") or ""
                        except Exception:
                            proto = ""
                        try:
                            src = pkt.ip.src if hasattr(pkt, "ip") and hasattr(pkt.ip, "src") else ""
                            dst = pkt.ip.dst if hasattr(pkt, "ip") and hasattr(pkt.ip, "dst") else ""
                        except Exception:
                            src, dst = "", ""
                        info = f"{proto} {src}->{dst}".strip()
                        try:
                            q.put_nowait({"time": ts_s, "src": src, "dst": dst, "proto": proto, "info": info})
                        except Exception:
                            pass
                    idx += 1
                last_index = idx
                try:
                    cap.close()
                except Exception:
                    pass
            except FileNotFoundError:
                time.sleep(0.5)
            except Exception as e:
                emsg = str(e)
                now = time.time()
                if emsg != last_error or (now - last_error_time) > 5.0:
                    last_error = emsg
                    last_error_time = now
                    try:
                        q.put_nowait({"time":"", "src":"", "dst":"", "proto":"ERROR", "info": emsg})
                    except Exception:
                        pass
                time.sleep(1.0)
            stop_event.wait(timeout=0.8)
    except Exception as e:
        try:
            q.put_nowait({"time":"", "src":"", "dst":"", "proto":"ERROR", "info": f"reader_fatal: {e}"})
        except Exception:
            pass

