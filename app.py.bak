import uuid
HONEYPOT_HOST = "http://127.0.0.1:5001"   # your honeypot service

def set_honeypot_session():
    sid = session.get("sid")
    if not sid:
        sid = str(uuid.uuid4())
        session["sid"] = sid
    session["honeypot_mode"] = True
    return sid

def redirect_to_honeypot_direct(session_id=None):
    sid = session_id or session.get("sid") or str(uuid.uuid4())
    return redirect(f"{HONEYPOT_HOST}/?sid={sid}", code=302)

