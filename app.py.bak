@app.route("/admin/honeypot_download")
def admin_honeypot_download():
    try:
        limit = int(request.args.get("limit", 200))
    except:
        limit = 200
    try:
        conn = _safe_get_db_conn(use_honeypot=True)
        cur = conn.cursor()
        cur.execute("SELECT sid, ip_address, user_agent, endpoint, method, payload, created_at FROM honeypot_access ORDER BY id DESC LIMIT ?", (limit,))
        rows = cur.fetchall()
        conn.close()
        lines = []
        for r in rows:
            o = dict(r)
            lines.append(json.dumps(o, default=str))
        content = "\n".join(lines)
        from flask import Response
        headers = {'Content-Disposition':'attachment; filename=honeypot_sessions.jsonl', 'Content-Type':'application/jsonl'}
        return Response(content, headers=headers)
    except Exception as e:
        logging.error("honeypot_download error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

@app.route("/admin/unblock_top", methods=["POST"])
def admin_unblock_top():
    try:
        conn = _safe_get_db_conn(use_honeypot=False)
        cur = conn.cursor()
        try:
            cur.execute("SELECT ip_address FROM blocklist WHERE active=1 ORDER BY created_at DESC LIMIT 1")
            row = cur.fetchone()
            if row:
                ip = row['ip_address']
                cur.execute("UPDATE blocklist SET active=0 WHERE ip_address=?",(ip,))
                conn.commit()
                conn.close()
                return jsonify({"message":f"Unblocked {ip}"}), 200
        except sqlite3.OperationalError:
            cur.execute("SELECT ip_address FROM blocklist ORDER BY ROWID DESC LIMIT 1")
            row = cur.fetchone()
            if row:
                ip = row['ip_address']
                cur.execute("DELETE FROM blocklist WHERE ip_address=?",(ip,))
                conn.commit()
                conn.close()
                return jsonify({"message":f"Removed block entry for {ip}"}), 200
        conn.close()
        return jsonify({"message":"No blocked IPs found"}), 200
    except Exception as e:
        logging.error("unblock_top error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

