# -------------------- Routes --------------------
@app.route("/", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        username = request.form["username"]
        password = request.form["password"]

        # ensure session sid & ip known
        ip = request.remote_addr
        sid = session.get("sid") or str(uuid.uuid4())
        session["sid"] = sid

        # ------------------ RATE-LIMIT (fast deterministic) ------------------
        try:
            # call register_login_attempt if you have it; otherwise skip
            exceeded = False
            if "register_login_attempt" in globals():
                exceeded = register_login_attempt(ip)
            if exceeded:
                # persist block
                if "block_ip" in globals():
                    block_ip(ip, reason="rate-limit-exceeded", duration_minutes=360)
                # clear any login session and send to honeypot/fake dashboard
                session.pop("user", None)
                session.pop("role", None)
                print(f"🔒 Auto-block triggered for IP {ip} due to rate-limit")
                return redirect_to_honeypot(session_id=sid)
        except Exception as e:
            print("⚠️ rate-limit check error:", e)
        # --------------------------------------------------------------------

        # run normal user check (unchanged)
        result = check_user(username, password)

        # ---------------------------------------------------------
        # 🔥 HONEYPOT DETECTION — your suspicious rules (unchanged)
        # ---------------------------------------------------------
        suspicious = False

        # Rule 1 — weird username patterns
        if len(username) < 2 or any(c in username for c in [';', '--', '/', '\\']):
            suspicious = True

        # Rule 2 — result is None AND username not in safe list
        SAFE_LIST = ["admin", "user1", "analyst", "employee"]
        if result is None and username not in SAFE_LIST:
            suspicious = True

        if suspicious:
            print("⚠️ Suspicious login detected from IP:", ip, "| username:", username)
            redirect_to_honeypot()
        # ---------------------------------------------------------
    # ---------------------------------------------------------

        # Send login event to Kafka (best-effort)
        if producer:
            try:
                event_data = {
                    "username": username,
                    "ip": request.remote_addr,
                    "timestamp": datetime.datetime.now().isoformat(),
                    "event": "login_success" if result else "login_fail"
                }
                producer.send('network-traffic', value=event_data)
            except Exception as e:
                print(f"⚠️ Kafka send error: {e}")

        # Logging & redirect behavior unchanged
        if result:
            session["user"] = result["username"]
            session["role"] = result["role"]

            # Log login attempt
            try:
                conn = get_db()
                cursor = conn.cursor()
                cursor.execute("""
                    INSERT INTO login_log (user_id, ip_address, status)
                    VALUES (NULL, ?, ?)
                """, (request.remote_addr, f"success ({result['role']})"))
                conn.commit()
            finally:
                try: conn.close()
                except: pass

            if result["role"] == "admin":
                return redirect(url_for("admin_dashboard"))
            else:
                return redirect(url_for("user_dashboard"))

        else:
            try:
                conn = get_db()
                cursor = conn.cursor()
                cursor.execute("""
                    INSERT INTO login_log (user_id, ip_address, status)
                    VALUES (NULL, ?, ?)
                """, (request.remote_addr, f"fail ({username})"))
                conn.commit()
            finally:
                try: conn.close()
                except: pass

            return render_template("login.html", error="❌ Invalid username or password")
    
    return render_template("login.html")

############################################# HONEY POT ROUTE ######
@app.before_request
def global_suspicion_filter():
    path = request.path
    ip = request.remote_addr
    sid = session.get("sid") or str(uuid.uuid4())
    session["sid"] = sid

    # ------------------------------------------------------
    # 1. ALLOW STATIC + LOGIN + ROOT (do not redirect)
    # ------------------------------------------------------
    if path.startswith("/static") or path == "/" or path == "/login":
        # Clear honeypot flag only for clean GET login/root
        if request.method == "GET":
            session.pop("honeypot_mode", None)
        return

    # ------------------------------------------------------
    # 2. BLOCKLIST CHECK
    # ------------------------------------------------------
    try:
        conn = get_db()
        cur = conn.cursor()
        cur.execute("SELECT id, expires_at FROM blocklist WHERE ip=? LIMIT 1", (ip,))
        row = cur.fetchone()

        if row:
            expires = row["expires_at"]

            # If expiry passed, unblock
            if expires:
                import datetime as _dt
                exp_ts = _dt.datetime.fromisoformat(expires)
                if exp_ts < _dt.datetime.now():
                    cur.execute("DELETE FROM blocklist WHERE id=?", (row["id"],))
                    conn.commit()
                else:
                    # Still blocked → redirect (not for admin)
                    if session.get("role") != "admin":
                        conn.close()
                        return redirect_to_honeypot(session_id=sid)
        conn.close()
    except Exception as e:
        print("⚠️ blocklist check error:", e)

    # ------------------------------------------------------
    # 3. SUSPICIOUS PATH CHECKS
    # ------------------------------------------------------
    if path.startswith("/honeypot") or path.startswith("/fake_dashboard"):
        return

    # Non-admin visiting admin pages
    if "admin" in path.lower() and session.get("role") != "admin":
        return redirect_to_honeypot(session_id=sid)

    # Empty/strange User-Agent
    ua = request.headers.get("User-Agent", "")
    if not ua.strip():
        return redirect_to_honeypot(session_id=sid)

