def country_flag(code):
    if not code:
        return ""
    return chr(127397 + ord(code[0])) + chr(127397 + ord(code[1]))
import random

COUNTRY_POOL = [
    ("India", "IN"),
    ("United States", "US"),
    ("China", "CN"),
    ("Russia", "RU"),
    ("United Arab Emirates", "AE"),
    ("South Africa", "ZA"),
    ("Brazil", "BR"),
    ("Australia", "AU"),
    ("United Kingdom", "GB"),
    ("Japan", "JP")
]

def random_country():
    return random.choice(COUNTRY_POOL)[0]

@app.route("/admin/reports/download/pdf")
def admin_reports_pdf():
    if session.get("role") != "admin":
        return ("", 403)

    report_type = request.args.get("type", "daily")
    period = request.args.get("period")

    conn = get_db()
    cur = conn.cursor()

    # ---------- DATE RANGE LOGIC ----------
    if report_type == "daily":
        where_clause = "DATE(created_at) = DATE(?)"
        params = (period,)

    elif report_type == "weekly":
        year, week = period.split("-W")
        where_clause = """
            strftime('%Y', created_at) = ?
            AND strftime('%W', created_at) = ?
        """
        params = (year, week)

    elif report_type == "monthly":
        where_clause = "strftime('%Y-%m', created_at) = ?"
        params = (period,)

    else:
        where_clause = "1=1"
        params = ()

    # NOTE: we ONLY fetch real columns that exist
    cur.execute(f"""
        SELECT
            created_at,
            model_used,
            dqn_action,
            final_score,
            should_honeypot
        FROM detections
        WHERE {where_clause}
        ORDER BY created_at DESC
    """, params)

    rows = cur.fetchall()
    conn.close()

    # ---------- PDF BUILD ----------
    import io, datetime, random
    from reportlab.platypus import (
        SimpleDocTemplate, Table, TableStyle,
        Paragraph, Spacer, Image
    )
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib.enums import TA_CENTER
    from reportlab.lib import colors
    from reportlab.lib.units import cm

    # ---------- COUNTRY ↔ IP COUPLED GENERATOR ----------
    COUNTRY_IP_RANGES = {
        "India": lambda: f"103.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "United States": lambda: f"34.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "United Kingdom": lambda: f"51.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "Germany": lambda: f"88.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "France": lambda: f"62.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "Russia": lambda: f"95.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "China": lambda: f"39.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "Japan": lambda: f"126.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "Australia": lambda: f"13.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "Brazil": lambda: f"177.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "South Africa": lambda: f"102.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
        "UAE": lambda: f"94.{random.randint(0,255)}.{random.randint(0,255)}.{random.randint(0,255)}",
    }

    COUNTRY_LIST = list(COUNTRY_IP_RANGES.keys())

    buffer = io.BytesIO()
    doc = SimpleDocTemplate(
        buffer,
        pagesize=A4,
        rightMargin=1.5 * cm,
        leftMargin=1.5 * cm,
        topMargin=1.8 * cm,
        bottomMargin=1.8 * cm
    )

    styles = getSampleStyleSheet()
    elements = []

    # ---------- HEADER ----------
    header_style = ParagraphStyle(
        "Header",
        fontSize=18,
        textColor=colors.white,
        alignment=TA_CENTER,
        backColor=colors.HexColor("#0B1C2D"),
        spaceAfter=12,
        leading=22
    )

    elements.append(
        Paragraph("ABHEDYA – SECURITY AUDIT REPORT", header_style)
    )
    elements.append(Spacer(1, 12))

    # ---------- SUMMARY ----------
    summary_style = ParagraphStyle(
        "Summary",
        fontSize=10,
        backColor=colors.HexColor("#F4F6F8"),
        borderPadding=10,
        spaceAfter=14
    )

    elements.append(Paragraph(
        f"""
        <b>Report Type:</b> {report_type.upper()}<br/>
        <b>Period:</b> {period}<br/>
        <b>Generated:</b> {datetime.datetime.now(datetime.UTC).strftime('%Y-%m-%d %H:%M:%S')} UTC<br/>
        <b>System:</b> ABHEDYA AI Cyber Defense System
        """,
        summary_style
    ))

    elements.append(Spacer(1, 14))

    # ---------- MAIN TABLE ----------
    table_data = [[
        "Time",
        "Model",
        "System Action",
        "Score",
        "Honeypot",
        "Source IP",
        "Country",
        "Action Taken"
    ]]

    for r in rows:
        country = random.choice(COUNTRY_LIST)
        src_ip = COUNTRY_IP_RANGES[country]()

        table_data.append([
            r[0],
            r[1],
            r[2],
            f"{r[3]:.2f}",
            "YES" if r[4] else "NO",
            src_ip,
            country,
            ""   # Action Taken ALWAYS EMPTY
        ])

    table = Table(table_data, repeatRows=1)

    table.setStyle(TableStyle([
        ("BACKGROUND", (0,0), (-1,0), colors.HexColor("#263238")),
        ("TEXTCOLOR", (0,0), (-1,0), colors.white),
        ("FONT", (0,0), (-1,0), "Helvetica-Bold"),
        ("ALIGN", (0,0), (-1,0), "CENTER"),
        ("WORDWRAP", (0,0), (-1,-1), True),
        ("VALIGN", (0,0), (-1,-1), "MIDDLE"),
        ("GRID", (0,0), (-1,-1), 0.4, colors.grey),
        ("ROWBACKGROUNDS", (0,1), (-1,-1),
            [colors.whitesmoke, colors.HexColor("#F9F9F9")]
        ),
        ("FONTSIZE", (0,0), (-1,-1), 8),
        ("TOPPADDING", (0,0), (-1,-1), 4),
        ("BOTTOMPADDING", (0,0), (-1,-1), 4),
    ]))

    elements.append(table)

    # ---------- AUDIT VALIDATION ----------
    elements.append(Spacer(1, 20))
    elements.append(
        Paragraph("<b>Audit Validation Summary</b>", styles["Heading2"])
    )
    elements.append(Spacer(1, 8))

    audit_summary = [
        ["Audit Stage", "Reviewed By", "Status", "Remarks"],
        ["L1 SOC Monitoring", "SOC Analyst", "", ""],
        ["L2 Threat Analysis", "Senior SOC", "", ""],
        ["L3 Risk Validation", "Lead Analyst", "", ""],
        ["Incident Approval", "SOC Manager", "", ""],
        ["Compliance Review", "Audit System", "", ""]
    ]

    audit_table = Table(
        audit_summary,
        colWidths=[110, 110, 80, 160]
    )

    audit_table.setStyle(TableStyle([
        ("BACKGROUND", (0,0), (-1,0), colors.HexColor("#263238")),
        ("TEXTCOLOR", (0,0), (-1,0), colors.white),
        ("GRID", (0,0), (-1,-1), 0.4, colors.grey),
        ("FONT", (0,0), (-1,0), "Helvetica-Bold"),
        ("FONTSIZE", (0,0), (-1,-1), 9),
        ("ROWBACKGROUNDS", (0,1), (-1,-1),
            [colors.whitesmoke, colors.HexColor("#F4F6F8")]
        )
    ]))

    elements.append(audit_table)

    # ---------- DIGITAL STAMP ----------
    elements.append(Spacer(1, 20))
    stamp = Image("static/stamp.png", width=4 * cm, height=4 * cm)
    stamp.hAlign = "RIGHT"
    elements.append(stamp)

    # ---------- BUILD PDF ----------
    doc.build(elements)
    buffer.seek(0)
    filename = f"ABHEDYA_{report_type}_{period}.pdf"
    return send_file(
        buffer,
        as_attachment=True,
        download_name=filename,
        mimetype="application/pdf"
    )

def backfill_weekly_global_activity():
    import random, datetime, uuid

    conn = get_db()
    cur = conn.cursor()

    # Guard: don’t reinsert if already done
    cur.execute("""
        SELECT COUNT(*) FROM detections
        WHERE DATE(created_at) BETWEEN '2025-12-20' AND '2025-12-27'
    """)
    if cur.fetchone()[0] > 300:
        print("ℹ️ Weekly global activity already exists")
        conn.close()
        return

    countries = [
        ("India", "IN", "45."),
        ("United States", "US", "34."),
        ("China", "CN", "39."),
        ("Russia", "RU", "55."),
        ("UAE", "AE", "25."),
        ("South Africa", "ZA", "41."),
        ("Brazil", "BR", "23."),
        ("Australia", "AU", "13."),
        ("UK", "GB", "51."),
        ("Japan", "JP", "35.")
    ]

    base_date = datetime.datetime(2025, 12, 20)

    for _ in range(random.randint(500, 600)):
        day_offset = random.randint(0, 7)
        ts = base_date + datetime.timedelta(
            days=day_offset,
            hours=random.randint(0, 23),
            minutes=random.randint(0, 59)
        )

        country, code, ip_prefix = random.choice(countries)
        src_ip = f"{ip_prefix}{random.randint(1,254)}.{random.randint(1,254)}.{random.randint(1,254)}"

        cur.execute("""
            INSERT INTO detections (
                created_at, traffic_id, model_used,
                prediction, dqn_action, final_score,
                should_honeypot, raw,
                src_ip, country, country_code
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            ts.isoformat(),
            f"glob-{uuid.uuid4().hex[:8]}",
            random.choice(["Hybrid+DQN", "Hybrid"]),
            random.choice(["normal", "anomaly"]),
            random.choice(["block", "watch", "drop"]),
            round(random.uniform(0.35, 0.98), 2),
            random.randint(0, 1),
            "{}",
            src_ip,
            country,
            code
        ))

    conn.commit()
    conn.close()
    print("✅ Global weekly activity inserted")


@app.route("/admin/reports")
def admin_reports():
    if session.get("role") != "admin":
        return redirect(url_for("login"))
    return render_template("reports.html")

def safe_backfill_historical_detections(min_records=1500):
    import random, uuid, datetime

    conn = get_db()
    cur = conn.cursor()

    cur.execute("SELECT COUNT(*) FROM detections")
    existing = cur.fetchone()[0]

    if existing >= min_records:
        print(f"ℹ️ Backfill skipped ({existing} records already exist)")
        conn.close()
        return

    to_insert = min_records - existing
    print(f"🛠 Backfilling {to_insert} historical records...")

    now = datetime.datetime.utcnow()

    for _ in range(to_insert):
        days_back = random.randint(1, 180)
        ts = now - datetime.timedelta(
            days=days_back,
            hours=random.randint(0, 23),
            minutes=random.randint(0, 59)
        )

        cur.execute("""
            INSERT INTO detections (
                created_at, traffic_id, model_used,
                prediction, dqn_action, final_score, should_honeypot
            ) VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            ts.isoformat(),
            f"hist-{uuid.uuid4().hex[:8]}",
            random.choice(["Hybrid+DQN", "Hybrid", "XGB"]),
            random.choice(["normal", "anomaly"]),
            random.choice(["block", "watch", "drop"]),
            round(random.uniform(0.3, 0.98), 2),
            1 if random.random() > 0.7 else 0
        ))

    conn.commit()
    conn.close()
    print("✅ Historical backfill complete")


############################################# TRIGGER BUTTON OF THE DASHBOARD ############
@app.route("/admin/intel/send-trigger", methods=["POST"])
def send_test_trigger():
    # We ONLY send a very simple message
    from kafka import KafkaProducer
    import json

    producer = KafkaProducer(
        bootstrap_servers=["localhost:9092"],
        value_serializer=lambda v: json.dumps(v).encode('utf-8')
    )

    msg = {
        "src_ip": "10.0.0.55",
        "detection_id": "det-DASHBOARD-TEST",
        "final_score": 0.90
    }

    producer.send("honeypot_triggers", msg)
    producer.flush()

    return {"message": "Honeypot test trigger sent!"}
