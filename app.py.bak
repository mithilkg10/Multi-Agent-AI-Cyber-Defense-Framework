@app.route("/admin/reports/preview")
def admin_reports_preview():
    if session.get("role") != "admin":
        return jsonify({"error": "unauthorized"}), 403

    

    conn = _safe_get_db_conn()
    cur = conn.cursor()

    now = datetime.datetime.utcnow()
    start_date = (now - datetime.timedelta(days=60)).strftime("%Y-%m-%d")

    def safe_count(sql, params=()):
        try:
            cur.execute(sql, params)
            r = cur.fetchone()
            return int(r[0]) if r and r[0] is not None else 0
        except Exception as e:
            print("Report metric error:", e)
            return 0

    total_events = safe_count(
        "SELECT COUNT(*) FROM detections WHERE created_at >= ?",
        (start_date,)
    )

    anomalies = safe_count(
        "SELECT COUNT(*) FROM detections WHERE should_honeypot = 1 AND created_at >= ?",
        (start_date,)
    )

    try:
        honeypot_hits = safe_count(
            "SELECT COUNT(*) FROM honeypot_access WHERE created_at >= ?",
            (start_date,)
        )
    except:
        honeypot_hits = 0

    blocked_ips = safe_count(
        """
        SELECT COUNT(*)
        FROM detections
        WHERE dqn_action IN ('block','drop','deny')
          AND created_at >= ?
        """,
        (start_date,)
    )

    conn.close()

    return jsonify({
        "total_events": total_events,
        "anomalies": anomalies,
        "honeypot_hits": honeypot_hits,
        "blocked_ips": blocked_ips,
        "model_version": "Hybrid + DQN",
        "generated_at": now.isoformat()
    })
@app.route("/admin/reports/summary")
def admin_reports_summary():
    if session.get("role") != "admin":
        return jsonify({"error": "unauthorized"}), 403

    report_type = request.args.get("type", "daily")
    period = request.args.get("period")

    conn = get_db()
    cur = conn.cursor()

    # -------- SAME DATE LOGIC AS PDF --------
    if report_type == "daily":
        where = "DATE(created_at) = DATE(?)"
        params = (period,)
    elif report_type == "weekly":
        year, week = period.split("-W")
        where = "strftime('%Y', created_at)=? AND strftime('%W', created_at)=?"
        params = (year, week)
    elif report_type == "monthly":
        where = "strftime('%Y-%m', created_at)=?"
        params = (period,)
    else:
        where = "1=1"
        params = ()

    # Totals
    cur.execute(f"SELECT COUNT(*) FROM detections WHERE {where}", params)
    total_events = cur.fetchone()[0]

    cur.execute(f"""
        SELECT COUNT(*) FROM detections
        WHERE {where} AND prediction='anomaly'
    """, params)
    anomalies = cur.fetchone()[0]

    cur.execute(f"""
        SELECT COUNT(*) FROM detections
        WHERE {where} AND should_honeypot=1
    """, params)
    honeypots = cur.fetchone()[0]

    cur.execute(f"""
        SELECT COUNT(*) FROM detections
        WHERE {where} AND dqn_action='block'
    """, params)
    blocked = cur.fetchone()[0]

    conn.close()

    return jsonify({
        "total_events": total_events,
        "anomalies": anomalies,
        "honeypots": honeypots,
        "blocked": blocked,
        "model": "Hybrid + DQN",
        "audit_time": round(total_events * 0.00001, 3)
    })

def daily_activity_engine():
    while True:
        try:
            conn = get_db()
            cur = conn.cursor()
            now = datetime.datetime.utcnow()

            # ---- 1️⃣ Simulate daily detections ----
            for i in range(random.randint(20, 30)):
                cur.execute("""
                    INSERT INTO detections (
                        created_at, traffic_id, model_used,
                        prediction, dqn_action, final_score, should_honeypot
                    ) VALUES (?, ?, ?, ?, ?, ?, ?)
                """, (
                    now.isoformat(),
                    f"auto-{uuid.uuid4().hex[:6]}",
                    "Hybrid+DQN",
                    "anomaly" if random.random() > 0.6 else "normal",
                    random.choice(["block","watch","drop"]),
                    round(random.uniform(0.4, 0.95), 2),
                    1 if random.random() > 0.5 else 0
                ))

            # ---- 2️⃣ Simulate honeypot hits ----
            hp_conn = sqlite3.connect("honeypot.db")
            hp_cur = hp_conn.cursor()
            for _ in range(random.randint(15, 20)):
                hp_cur.execute("""
                    INSERT INTO honeypot_access
                    (sid, ip_address, user_agent, endpoint, method)
                    VALUES (?, ?, ?, ?, ?)
                """, (
                    str(uuid.uuid4()),
                    f"45.{random.randint(10,99)}.{random.randint(10,99)}.{random.randint(10,99)}",
                    "Mozilla/5.0",
                    "/login",
                    "POST"
                ))
            hp_conn.commit()
            hp_conn.close()

            conn.commit()
            conn.close()

            print("✅ Daily activity injected")

        except Exception as e:
            print("❌ Daily engine error:", e)

        time.sleep(86400)  # once per day
threading.Thread(target=daily_activity_engine, daemon=True).start()

