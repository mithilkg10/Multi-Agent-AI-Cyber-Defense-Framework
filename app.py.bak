@app.route("/_admin/clear_honeypot", methods=["POST"])
def clear_honeypot_route():
    # Only allow admin or local dev
    if session.get("role") != "admin" and request.remote_addr != "127.0.0.1":
        return ("", 403)
    session.pop("honeypot_mode", None)
    return jsonify({"status": "cleared"})

@app.route("/admin/approve/<int:req_id>", methods=["GET", "POST"])
def approve_request(req_id):
    conn = sqlite3.connect(DB_NAME, timeout=10, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    cursor = conn.cursor()

    # Fetch request details
    cursor.execute("SELECT * FROM registration_requests WHERE id=?", (req_id,))
    req = cursor.fetchone()

    if not req:
        conn.close()
        return redirect(url_for("admin_requests"))

    full_name = req["full_name"]
    department = req["department"]
    username = full_name.replace(" ", "").lower()
    temp_password = "Temp@123"

    # ✅ If POST, process admin's decision
    if request.method == "POST":
        action = request.form.get("action")
        if action == "skip":
            cursor.execute("UPDATE registration_requests SET status='approved' WHERE id=?", (req_id,))
            safe_commit(conn)
            conn.close()
            return redirect(url_for("admin_requests"))

        elif action == "rename":
            new_username = request.form.get("new_username").strip().lower()
            if not new_username:
                conn.close()
                return render_template(
                    "resolve_conflict.html", req=req,
                    error="⚠️ Please enter a valid new username."
                )
            cursor.execute("""
                INSERT INTO users (username, password, role)
                VALUES (?, ?, 'analyst')
            """, (new_username, temp_password))
            cursor.execute("UPDATE registration_requests SET status='approved' WHERE id=?", (req_id,))
            safe_commit(conn)
            conn.close()
            return redirect(url_for("admin_requests"))

    # ✅ If GET, check for username conflict
    cursor.execute("SELECT * FROM users WHERE username=?", (username,))
    existing = cursor.fetchone()

    if existing:
        # Username already exists → ask admin for decision
        conn.close()
        return render_template("resolve_conflict.html", req=req, existing_username=username)
    else:
        # No conflict → approve directly
        cursor.execute("""
            INSERT INTO users (username, password, role)
            VALUES (?, ?, 'analyst')
        """, (username, temp_password))
        cursor.execute("UPDATE registration_requests SET status='approved' WHERE id=?", (req_id,))
        safe_commit(conn)
        conn.close()
        return redirect(url_for("admin_requests"))


