########################################################################################### t shark routes ########################################
@app.route("/capture/start", methods=["POST"])
def start_capture():
    if "user" not in session or session.get("role") != "admin":
        return ("", 403)

    iface = request.form.get("iface", "").strip()
    bpf = request.form.get("bpf", "").strip() or None
    if not iface:
        return jsonify({"error":"Interface required"}), 400

    capture_id = str(uuid.uuid4())
    filename = os.path.join(CAPTURE_DIR, f"{capture_id}.pcap")
    q = Queue(maxsize=2000)
    stop_event = threading.Event()

    # start tshark process
    try:
        proc = _start_tshark_capture_process(capture_id, iface, bpf, filename)
    except Exception as e:
        return jsonify({"error": f"Failed to start tshark: {e}"}), 500

    # start file-reader streamer thread (parses pcap and pushes summaries to queue)
    reader_thread = threading.Thread(target=_pcap_reader_streamer, args=(capture_id, filename, q, stop_event), daemon=True)
    reader_thread.start()

    # store in-memory state (no DB)
    capture_objects[capture_id] = {"proc": proc, "queue": q, "filename": filename, "stop_event": stop_event, "thread": reader_thread}
    return jsonify({"capture_id": capture_id, "filename": filename}), 200

@app.route("/capture/stop", methods=["POST"])
def stop_capture():
    if "user" not in session or session.get("role") != "admin":
        return ("", 403)

    capture_id = request.form.get("capture_id")
    info = capture_objects.get(capture_id)
    if not info:
        return jsonify({"error":"capture not found"}), 404

    # stop reader thread
    info["stop_event"].set()
    th = info.get("thread")
    if th and th.is_alive():
        th.join(timeout=2)

    # terminate tshark process cleanly
    proc = info.get("proc")
    try:
        if proc and proc.poll() is None:
            proc.terminate()
            proc.wait(timeout=5)
    except Exception:
        try:
            proc.kill()
        except:
            pass

    # keep the pcap file available for download — we do NOT touch DB here
    # Remove from in-memory active map (but file remains)
    capture_objects.pop(capture_id, None)

    return jsonify({"status":"stopped", "capture_id": capture_id}), 200
@app.route("/capture/stream/<capture_id>")
def stream_capture(capture_id):
    if "user" not in session:
        return ("", 403)
    info = capture_objects.get(capture_id)
    if not info:
        return ("", 404)
    q = info["queue"]

    def event_stream():
        # stream until queue is drained and process ended
        while True:
            try:
                pkt = q.get(timeout=5)
                yield f"data: {json.dumps(pkt)}\n\n"
            except Empty:
                # if proc and thread are gone and queue empty, end
                proc = info.get("proc")
                th = info.get("thread")
                if (not proc or proc.poll() is not None) and (not th or not th.is_alive()):
                    break
                # else loop and wait more
        yield "event: end\ndata: {}\n\n"

    return Response(event_stream(), mimetype="text/event-stream")



