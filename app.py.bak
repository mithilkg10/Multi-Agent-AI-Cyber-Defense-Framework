# -------------------- Robust admin JSON & stats endpoints --------------------
import traceback, logging
logging.basicConfig(level=logging.INFO)

def _safe_get_db_conn(use_honeypot=False):
    try:
        if use_honeypot:
            if 'get_hp_db' in globals():
                return get_hp_db()
            hp_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'honeypot.db')
            conn = sqlite3.connect(hp_path, timeout=30, check_same_thread=False)
            conn.row_factory = sqlite3.Row
            try:
                conn.execute("PRAGMA journal_mode=WAL;")
                conn.execute("PRAGMA synchronous=NORMAL;")
                conn.execute("PRAGMA busy_timeout=5000;")
            except Exception:
                pass
            return conn
        else:
            if 'get_db' in globals():
                return get_db()
            conn = sqlite3.connect(DB_NAME, timeout=30, check_same_thread=False)
            conn.row_factory = sqlite3.Row
            try:
                conn.execute("PRAGMA journal_mode=WAL;")
                conn.execute("PRAGMA synchronous=NORMAL;")
                conn.execute("PRAGMA busy_timeout=5000;")
            except Exception:
                pass
            return conn
    except Exception as e:
        logging.error("DB open error: %s", e)
        raise

# ----------------- Defensive admin statistics endpoints -----------------
import sqlite3, traceback, json
from collections import Counter

def _table_exists(conn, name):
    try:
        cur = conn.cursor()
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name=?",(name,))
        return bool(cur.fetchone())
    except Exception:
        return False

@app.route("/admin/honeypot_logs_json")
def admin_honeypot_logs_json():
    limit = int(request.args.get("limit", 200))
    try:
        conn = _safe_get_db_conn(use_honeypot=True)
        cur = conn.cursor()
        if _table_exists(conn, "honeypot_access"):
            cur.execute("SELECT id, sid, ip_address, user_agent, endpoint, method, created_at FROM honeypot_access ORDER BY id DESC LIMIT ?", (limit,))
            rows = [dict(r) for r in cur.fetchall()]
        elif _table_exists(conn, "honeypot_events"):
            cur.execute("SELECT id, ip, sid, event as user_agent, score, created_at FROM honeypot_events ORDER BY id DESC LIMIT ?", (limit,))
            rows_raw = [dict(r) for r in cur.fetchall()]
            rows = []
            for r in rows_raw:
                rows.append({
                    "id": r.get("id"),
                    "sid": r.get("sid"),
                    "ip_address": r.get("ip"),
                    "user_agent": r.get("event") or r.get("user_agent"),
                    "endpoint": "(hp_event)",
                    "method": "-",
                    "created_at": r.get("created_at")
                })
        else:
            rows = []
        conn.close()
        return jsonify(rows)
    except Exception as e:
        app.logger.error("admin_honeypot_logs_json error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500
