###################################### rate based stopping ##########
# ================= RATE LIMITER GLOBALS =====================
from collections import deque, defaultdict
import threading

# Rate limiter settings
_RATE_WINDOW_SECONDS = 60
_RATE_THRESHOLD = 10  # If >10 login attempts in 60s -> block automatically

_rate_map = defaultdict(lambda: deque())  # ip -> deque of timestamps
_rate_lock = threading.Lock()

def block_ip(ip, reason="auto-rate-limit", duration_minutes=360):
    """Insert entry into blocklist table."""
    import datetime
    try:
        conn = get_db()
        cur = conn.cursor()
        expires = (datetime.datetime.now() +
                   datetime.timedelta(minutes=duration_minutes)).isoformat()

        cur.execute("""
            INSERT INTO blocklist (ip, reason, created_at, expires_at)
            VALUES (?, ?, ?, ?)
        """, (ip, reason, datetime.datetime.now().isoformat(), expires))

        conn.commit()
        conn.close()
        print(f"🔒 BLOCKED IP: {ip} (reason={reason})")
    except Exception as e:
        print("⚠️ block_ip error:", e)
def register_login_attempt(ip):
    """Tracks login attempts and returns True if limit exceeded."""
    import time
    now = time.time()

    with _rate_lock:
        dq = _rate_map[ip]
        dq.append(now)

        # Remove timestamps older than window
        cutoff = now - _RATE_WINDOW_SECONDS
        while dq and dq[0] < cutoff:
            dq.popleft()

        # Check threshold
        return len(dq) > _RATE_THRESHOLD


def clear_rate_history(ip):
    """Clear memory record for IP (on admin unblock)."""
    with _rate_lock:
        _rate_map.pop(ip, None)

