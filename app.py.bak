DB = os.getenv("INTEL_DB", "intelligence_assets.db")  # created earlier

def get_db_conn(path=DB):
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn

# --- INDEX / list with server-side pagination (fallback if not using DataTables server-side) ---
@app.route("/admin/intel")
def admin_intel():
    q = request.args.get("q", "").strip()
    page = max(1, int(request.args.get("page", 1)))
    per_page = int(request.args.get("per_page", 50))
    offset = (page - 1) * per_page

    base = "SELECT id, asset_id, codename, nationality, affiliation, threat_level, status, last_known_location, mission_priority, extraction_needed, last_contact_ts, reliability_score FROM intelligence_assets"
    params = []
    if q:
        base += " WHERE asset_id LIKE ? OR codename LIKE ? OR real_name LIKE ? OR affiliation LIKE ? OR last_known_location LIKE ?"
        params.extend([f"%{q}%"]*5)
    base += " ORDER BY threat_level DESC, last_contact_ts DESC LIMIT ? OFFSET ?"
    params.extend([per_page, offset])

    conn = get_db_conn()
    cur = conn.cursor()
    cur.execute(base, params)
    rows = cur.fetchall()

    # get total count for basic pagination UI
    count_q = "SELECT COUNT(*) FROM intelligence_assets"
    if q:
        count_q = "SELECT COUNT(*) FROM intelligence_assets WHERE asset_id LIKE ? OR codename LIKE ? OR real_name LIKE ? OR affiliation LIKE ? OR last_known_location LIKE ?"
        cur2 = conn.execute(count_q, [f"%{q}%"]*5)
    else:
        cur2 = conn.execute(count_q)
    total = cur2.fetchone()[0]
    conn.close()

    return render_template("admin_intel.html", rows=rows, page=page, per_page=per_page, total=total, q=q)
