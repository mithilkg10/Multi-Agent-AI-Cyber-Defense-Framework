# --- CSV Export ---
@app.route("/admin/intel/export")
def admin_intel_export():
    conn = get_db_conn()
    cur = conn.execute("SELECT * FROM intelligence_assets")
    cols = [d[0] for d in cur.description]

    def stream():
        out = io.StringIO()
        writer = csv.writer(out)
        writer.writerow(cols)
        yield out.getvalue()
        out.seek(0); out.truncate(0)
        for r in cur:
            writer.writerow([r[c] for c in cols])
            yield out.getvalue()
            out.seek(0); out.truncate(0)
    headers = {
        "Content-Disposition": "attachment; filename=intelligence_assets.csv"
    }
    return Response(stream(), mimetype="text/csv", headers=headers)

