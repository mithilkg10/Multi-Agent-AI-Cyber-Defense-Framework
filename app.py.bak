@app.route("/capture/download/<capture_id>")
def download_capture(capture_id):
    if "user" not in session:
        return ("", 403)
    info = capture_objects.get(capture_id)
    filename = None
    if info:
        filename = info.get("filename")
    else:
        # if capture not active, look for file on disk
        filename = os.path.join(CAPTURE_DIR, f"{capture_id}.pcap")
    if not os.path.exists(filename):
        return ("Not found", 404)
    return send_file(filename, as_attachment=True)

