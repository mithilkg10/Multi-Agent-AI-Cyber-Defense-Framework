import sqlite3, traceback, datetime, random, string

# --- defensive DB connection helper (paste into app.py, replacing the older function) ---
import os, sqlite3

def _get_db_path_candidates():
    base = os.getcwd()
    return [
        os.path.join(base, "cyber_defense.db"),
        os.path.join(base, "cyber_defense.sqlite"),
        os.path.join(base, "cyber_defense.sqlite3"),
        os.path.join(base, "cyber_defense.db3"),
        os.path.join(base, "cyber_defense.sqlite"),
    ]

def _safe_get_db_conn(*args, **kwargs):
    use_honeypot = bool(kwargs.get("use_honeypot", False))
    candidates = []
    cwd = os.getcwd()
    if use_honeypot:
        candidates.append(os.path.join(cwd, "honeypot.db"))
    candidates.extend(_get_db_path_candidates())
    candidates.extend([os.path.join(cwd, "honeypot.db"), os.path.join(cwd, "cyber_defense.db"), "cyber_defense.db"])
    for p in candidates:
        try:
            if p and os.path.exists(p):
                conn = sqlite3.connect(p, timeout=30, check_same_thread=False)
                conn.row_factory = sqlite3.Row
                try:
                    conn.execute("PRAGMA journal_mode=WAL;")
                    conn.execute("PRAGMA synchronous=NORMAL;")
                    conn.execute("PRAGMA busy_timeout=5000;")
                except Exception:
                    pass
                return conn
        except Exception:
            continue
    conn = sqlite3.connect("cyber_defense.db", timeout=30, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn

@app.route("/admin/detections_json")
def admin_detections_json():
