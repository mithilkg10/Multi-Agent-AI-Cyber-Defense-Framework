@app.route("/admin/login_logs_json")
def admin_login_logs_json():
    limit = int(request.args.get("limit", 200))
    try:
        conn = _safe_get_db_conn()
        cur = conn.cursor()
        table_candidates = ["login_log", "login_logs", "login_log_stream"]
        rows = []
        for t in table_candidates:
            if _table_exists(conn, t):
                cur.execute(f"SELECT * FROM {t} ORDER BY id DESC LIMIT ?", (limit,))
                rows = [dict(r) for r in cur.fetchall()]
                break
        conn.close()
        out = []
        for r in rows:
            out.append({
                "id": r.get("id"),
                "ip_address": r.get("ip_address") or r.get("ip") or r.get("remote_addr") or r.get("host"),
                "endpoint": r.get("endpoint") or r.get("path") or r.get("route"),
                "created_at": r.get("created_at") or r.get("timestamp") or r.get("time")
            })
        return jsonify(out)
    except Exception as e:
        app.logger.error("admin_login_logs_json error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

@app.route("/admin/stats/top_attack_types_json")
def admin_stats_top_attack_types_json():
    try:
        limit = int(request.args.get("limit", 8))
    except:
        limit = 8
    try:
        conn = _safe_get_db_conn()
        cur = conn.cursor()
        types = []
        if _table_exists(conn, "honeypot_events"):
            cur.execute("SELECT event FROM honeypot_events")
            types = [r["event"] for r in cur.fetchall()]
        elif _table_exists(conn, "detections"):
            cur.execute("SELECT type FROM detections")
            types = [r.get("type") for r in cur.fetchall()]
        conn.close()
        cnt = Counter([t for t in types if t])
        out = [{"type": k, "count": v} for k, v in cnt.most_common(limit)]
        return jsonify(out)
    except Exception as e:
        app.logger.error("admin_stats_top_attack_types_json error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

@app.route("/admin/stats/ip_geo_json")
def admin_stats_ip_geo_json():
    try:
        hours = int(request.args.get("hours", 15))
    except:
        hours = 15
    try:
        conn = _safe_get_db_conn(use_honeypot=False)
        cur = conn.cursor()
        time_cutoff = datetime.datetime.utcnow() - datetime.timedelta(hours=hours)
        try:
            cur.execute("SELECT strftime('%Y-%m-%d %H:00', login_time) AS bucket, ip_address FROM login_log WHERE login_time >= ? ORDER BY bucket ASC", (time_cutoff.isoformat(),))
            rows = cur.fetchall()
            data = {}
            for r in rows:
                b = r['bucket']; ip = r.get('ip_address') or r.get('ip') or ''
                rec = data.setdefault(b, {'bucket': b, 'india':0, 'foreign':0})
                if ip.startswith(("10.","172.","192.","127.")) or ip == "":
                    rec['india'] += 1
                else:
                    rec['foreign'] += 1
            out = [data[k] for k in sorted(data.keys())]
        except Exception:
            cur.execute("SELECT strftime('%Y-%m-%d %H:00', created_at) AS bucket, ip_address FROM honeypot_access WHERE created_at >= ? ORDER BY bucket ASC", (time_cutoff.isoformat(),))
            rows = cur.fetchall()
            data = {}
            for r in rows:
                b = r['bucket']; ip = r.get('ip_address') or ''
                rec = data.setdefault(b, {'bucket': b, 'india':0, 'foreign':0})
                if ip.startswith(("10.","172.","192.","127.")) or ip == "":
                    rec['india'] += 1
                else:
                    rec['foreign'] += 1
            out = [data[k] for k in sorted(data.keys())]
        conn.close()
        if not out:
            now = datetime.datetime.utcnow().replace(minute=0, second=0, microsecond=0)
            out = []
            for i in range(hours,0,-1):
                b = (now - datetime.timedelta(hours=i-1)).strftime('%Y-%m-%d %H:00')
                out.append({'bucket': b, 'india':0, 'foreign':0})
        return jsonify(out)
    except Exception as e:
        logging.error("admin_ip_geo_json error: %s\n%s", e, traceback.format_exc())
        return jsonify({"error":"server error","detail":str(e)}), 500

@app.route("/admin/summary")
def admin_summary():
    try:
        conn = _safe_get_db_conn(use_honeypot=True)
        cur = conn.cursor()
        cur.execute("SELECT COUNT(1) as cnt FROM honeypot_access")
        row = cur.fetchone()
        total_hp = int(row["cnt"]) if row else 0
        conn.close()
    except Exception as e:
        logging.warning("summary: honeypot read failed: %s", e)
        total_hp = 0
    try:
        conn2 = _safe_get_db_conn(use_honeypot=False)
        cur2 = conn2.cursor()
        try:
            cur2.execute("SELECT COUNT(1) as cnt FROM blocklist WHERE active=1")
            bl = cur2.fetchone()
            bl_count = int(bl["cnt"]) if bl else 0
        except sqlite3.OperationalError:
            cur2.execute("SELECT COUNT(1) as cnt FROM blocklist")
            bl = cur2.fetchone()
            bl_count = int(bl["cnt"]) if bl else 0
        conn2.close()
    except Exception as e:
        logging.warning("summary: blocklist read failed: %s", e)
        bl_count = 0
    engagement_pct = int(min(100, (total_hp / max(1, (bl_count+1))) * 3))
    return jsonify({"hp_engagement_pct": engagement_pct, "blocklist_count": bl_count})



