# pyshark_to_predict.py  (safe, exits after max_batches)
import argparse
import time
import json
import requests
import pyshark
from datetime import datetime

# optional kafka
try:
    from kafka import KafkaProducer
except Exception:
    KafkaProducer = None

PREDICT_URL = "http://127.0.0.1:5000/predict"
DEFAULT_IFACE = "Wi-Fi"
DEFAULT_COUNT = 50
KAFKA_TOPIC = "abhedya_packets"
KAFKA_BOOTSTRAP = "localhost:9092"

def extract_features_from_pkt(pkt):
    feat = {}
    try:
        feat["Tot size"] = int(getattr(pkt, "length", 0) or 0)
    except Exception:
        feat["Tot size"] = 0
    proto = getattr(pkt, "highest_layer", None) or ""
    feat["Protocol Type"] = proto.upper() if proto else "TCP"
    try:
        if "TCP" in feat["Protocol Type"] or hasattr(pkt, "tcp"):
            tcp = pkt.tcp
            feat["fin_flag_number"] = int(getattr(tcp, "flags_fin", 0) or 0)
            feat["syn_flag_number"] = int(getattr(tcp, "flags_syn", 0) or 0)
            feat["rst_flag_number"] = int(getattr(tcp, "flags_rst", 0) or 0)
            feat["psh_flag_number"] = int(getattr(tcp, "flags_push", 0) or 0)
            feat["ack_flag_number"] = int(getattr(tcp, "flags_ack", 0) or 0)
            feat["ece_flag_number"] = int(getattr(tcp, "flags_ece", 0) or 0)
            feat["cwr_flag_number"] = int(getattr(tcp, "flags_cwr", 0) or 0)
        else:
            feat.update({k: 0 for k in [
                "fin_flag_number","syn_flag_number","rst_flag_number","psh_flag_number",
                "ack_flag_number","ece_flag_number","cwr_flag_number"
            ]})
    except Exception:
        feat.update({k: 0 for k in [
            "fin_flag_number","syn_flag_number","rst_flag_number","psh_flag_number",
            "ack_flag_number","ece_flag_number","cwr_flag_number"
        ]})

    feat["ack_count"] = 0
    feat["syn_count"] = 0
    feat["fin_count"] = 0
    feat["rst_count"] = 0

    try:
        if hasattr(pkt, "ip"):
            feat["Header_Length"] = int(getattr(pkt.ip, "hdr_len", 0) or 0)
            feat["Time_To_Live"] = int(getattr(pkt.ip, "ttl", 0) or 0)
    except Exception:
        feat["Header_Length"] = 0
        feat["Time_To_Live"] = 0

    feat["Rate"] = 0.0
    feat["IAT"] = 0.0
    feat["Tot sum"] = feat.get("Tot size", 0)
    feat["AVG"] = feat.get("Tot size", 0)
    feat["Std"] = 0.0
    feat["Variance"] = 0.0
    feat["Min"] = feat.get("Tot size", 0)
    feat["Max"] = feat.get("Tot size", 0)
    feat["Number"] = 1

    txt = str(pkt)
    feat["HTTP"] = 1 if "HTTP" in txt else 0
    feat["HTTPS"] = 1 if "TLS" in txt or "SSL" in txt else 0
    feat["DNS"] = 1 if "DNS" in txt else 0
    feat["SSH"] = 1 if "SSH" in txt else 0
    feat["TCP"] = 1 if "TCP" in feat["Protocol Type"] or "TCP" in txt else 0
    feat["UDP"] = 1 if "UDP" in feat["Protocol Type"] or "UDP" in txt else 0
    feat["ICMP"] = 1 if "ICMP" in feat["Protocol Type"] else 0
    feat["ARP"] = 1 if "ARP" in feat["Protocol Type"] else 0
    feat["DHCP"] = 1 if "DHCP" in txt else 0
    return feat

def run_live(interface, batch_count, use_kafka=False, kafka_bootstrap=None, topic=None, max_batches=None, post_delay=0.05):
    if use_kafka and KafkaProducer is None:
        raise RuntimeError("kafka-python not installed. Install with pip install kafka-python")

    kafka_producer = None
    if use_kafka:
        kafka_bootstrap = kafka_bootstrap or KAFKA_BOOTSTRAP
        kafka_producer = KafkaProducer(bootstrap_servers=[kafka_bootstrap],
                                       value_serializer=lambda v: json.dumps(v).encode('utf-8'))

    cap = pyshark.LiveCapture(interface=interface)
    batch = []
    batches_sent = 0
    print(f"[pyshark] starting live capture on {interface} (batch_size={batch_count})")
    for pkt in cap.sniff_continuously():
        try:
            f = extract_features_from_pkt(pkt)
            f["_ts"] = datetime.utcnow().isoformat()
            batch.append(f)
        except Exception as e:
            print("[pyshark] pkt extract error:", e)
        if len(batch) >= batch_count:
            for rec in batch:
                try:
                    if use_kafka:
                        kafka_producer.send(topic or KAFKA_TOPIC, rec)
                    else:
                        r = requests.post(PREDICT_URL, json=rec, timeout=5)
                        print("[pyshark->http]", r.status_code, (r.text[:200] + '...') if len(r.text)>200 else r.text)
                    time.sleep(post_delay)
                except Exception as e:
                    print("[pyshark->send] error:", e)
            batch = []
            batches_sent += 1
            if max_batches is not None and batches_sent >= max_batches:
                print(f"[pyshark] reached max_batches={max_batches} - exiting cleanly")
                cap.close()
                break
            time.sleep(0.2)

if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("--iface", default=DEFAULT_IFACE)
    p.add_argument("--count", type=int, default=DEFAULT_COUNT)
    p.add_argument("--use-kafka", action="store_true")
    p.add_argument("--kafka-bootstrap", default=KAFKA_BOOTSTRAP)
    p.add_argument("--kafka-topic", default=KAFKA_TOPIC)
    p.add_argument("--max-batches", type=int, default=None, help="Exit after sending this many batches")
    p.add_argument("--post-delay", type=float, default=0.05, help="Delay between posting individual records (seconds)")
    args = p.parse_args()
    run_live(args.iface, args.count, use_kafka=args.use_kafka, kafka_bootstrap=args.kafka_bootstrap, topic=args.kafka_topic, max_batches=args.max_batches, post_delay=args.post_delay)
