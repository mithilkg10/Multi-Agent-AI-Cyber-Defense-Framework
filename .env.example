# ABHEDYA environment template
# Copy to .env for local use. Never commit real secrets.

# Flask session signing
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Honeypot session signing
HONEYPOT_SECRET=replace-with-a-long-random-value

# Service locations
HONEYPOT_HOST=http://127.0.0.1:5001
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional runtime paths
ABHEDYA_DB=cyber_defense.db
HONEYPOT_DB=honeypot.db
INTELLIGENCE_DB=intelligence_assets.db
