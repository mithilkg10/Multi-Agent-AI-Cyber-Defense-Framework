# ABHEDYA environment reference
# Export these values in the process environment before starting services.
# The application does not currently auto-load this file.

# Honeypot Flask session signing
HONEYPOT_SECRET=replace-with-a-long-random-value

# Main application -> honeypot service location
HONEYPOT_HOST=http://127.0.0.1:5001

# Kafka connectivity and topic names
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_IN_TOPIC=network-traffic
KAFKA_PRED_TOPIC=predictions
KAFKA_HONEYPOT_TOPIC=honeypot_triggers
KAFKA_GROUP_ID=models-prediction-consumer-1
HONEYPOT_GROUP=honeypot-controller-group

# Detection / response persistence
SQLITE_DB=cyber_defense.db
ABHEDYA_DB=cyber_defense.db
INTELLIGENCE_DB=intelligence_assets.db

# HMAC key used to sign stored detection-log metadata
ABHEDYA_LOG_HMAC_KEY=replace-with-a-long-random-value

# Honeypot controller runtime
HONEYPOT_PORT=5001
HONEYPOT_LOG_DIR=honeypot_logs
HONEYPOT_DRY_RUN=true
