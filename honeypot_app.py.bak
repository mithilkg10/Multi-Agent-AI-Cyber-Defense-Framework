# honeypot_app.py
# Honeypot service (port 5001)
# - Reads real intel table from cyber_defense.db in READ-ONLY mode
# - Column-wise permutes values (no invented tokens) and ensures no permuted value equals original
# - Renders honeypot.html with the scrambled dataset (all rows)
# - Logs accesses to honeypot.db (local) for forensics

from flask import Flask, request, session, render_template, url_for, jsonify
import sqlite3, os, uuid, json, hashlib, random, time

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
HONEYPOT_DB = os.path.join(BASE_DIR, "honeypot.db")
REAL_DB =  os.path.join(BASE_DIR, "intelligence_assets.db")   # adjust if real DB lives elsewhere

app = Flask(__name__, template_folder="templates")
app.secret_key = os.environ.get("HONEYPOT_SECRET", "hp-secret-change-me")

# -------------------- DB helpers --------------------
def get_hp_db():
    conn = sqlite3.connect(HONEYPOT_DB, timeout=30, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    try:
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
    except Exception:
        pass
    return conn

def init_hp_db():
    conn = get_hp_db()
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS honeypot_access (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sid TEXT,
            ip_address TEXT,
            user_agent TEXT,
            endpoint TEXT,
            method TEXT,
            payload TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

# -------------------- read real intel rows (READ-ONLY) --------------------
# Column list must match admin_intel.html presentation (order preserved)
INTEL_COLUMNS = [
    "id",
    "asset_id",
    "codename",
    "nationality",
    "affiliation",
    "threat_level",
    "status",
    "last_known_location",
    "mission_priority",
    "extraction_needed",
    "last_contact_ts",
    "reliability_score"
]


def fetch_real_intel_rows(limit=None):
    """
    Read all (or up to 'limit') rows from the real DB in read-only mode.
    Tries likely table names. Returns list[dict] or [].
    """
    if not os.path.exists(REAL_DB):
        return []
    try:
        # read-only sqlite connection
        conn = sqlite3.connect(f'file:{REAL_DB}?mode=ro', uri=True)
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()
        candidates = ["intelligence_assets", "admin_intel", "intel", "assets"]
        rows = []
        for table in candidates:
            try:
                if limit:
                    sql = f"SELECT {', '.join(INTEL_COLUMNS)} FROM {table} LIMIT ?"
                    cur.execute(sql, (limit,))
                else:
                    sql = f"SELECT {', '.join(INTEL_COLUMNS)} FROM {table}"
                    cur.execute(sql)
                fetched = [dict(r) for r in cur.fetchall()]
                if fetched:
                    rows = fetched
                    break
            except Exception:
                # table doesn't exist, try next candidate
                continue
        conn.close()
        return rows
    except Exception as e:
        print("fetch_real_intel_rows error:", e)
        return []




# -------------------- Permutation (column-wise derangement) --------------------
def column_derangement_shuffle(columns_list, seed_int):
    """
    Given a list of values for a column, produce a permutation (derangement) such that
    no value remains in its original index when possible. If derangement impossible
    (e.g. many identical values), fall back to rotate by 1.
    """
    n = len(columns_list)
    if n <= 1:
        return columns_list[:]  # nothing to shuffle

    rnd = random.Random(seed_int)
    # attempt to find a derangement by repeated shuffles (limited attempts)
    arr = columns_list[:]
    attempts = 0
    max_attempts = 12
    while attempts < max_attempts:
        rnd.shuffle(arr)
        conflict = False
        for i in range(n):
            if str(arr[i]) == str(columns_list[i]):
                conflict = True
                break
        if not conflict:
            return arr
        attempts += 1

    # if we couldn't derange (likely due to many identical values), perform deterministic rotate
    rotated = columns_list[1:] + columns_list[:1]
    # if rotation still leaves some equal (rare), rotate by larger step
    step = 1
    while any(str(rotated[i]) == str(columns_list[i]) for i in range(n)) and step < n:
        step = step + 1
        rotated = columns_list[step:] + columns_list[:step]
    return rotated

def scramble_rows_preserve_values(seed_str, rows):
    """
    Column-wise shuffle: collect each column's values, derange them, reassemble rows.
    Guarantee: for permuted columns none of the cell values equal their original cell value,
    unless impossible (identical column full of same value), in which case rotation ensures minimal leakage.
    Does NOT fabricate new strings; only permutes original strings.
    """
    if not rows:
        return []

    # Ensure consistent ordering
    ordered_rows = [ {k: r.get(k, "") for k in INTEL_COLUMNS} for r in rows ]
    n = len(ordered_rows)

    # Build column value lists for fields we will permute (we permute all except keep ID but we will replace ID with HP-... to avoid showing real IDs)
    fields = [f for f in INTEL_COLUMNS if f != "id"]
    columns = {f: [ordered_rows[i].get(f, "") for i in range(n)] for f in fields}

    # derive deterministic seed int from sid
    seed_int = int(hashlib.sha256(seed_str.encode('utf-8')).hexdigest()[:16], 16)

    # Derangement per column
    permuted_columns = {}
    for f in fields:
        permuted_columns[f] = column_derangement_shuffle(columns[f], seed_int ^ (hash(f) & 0xffffffff))

    # Reassemble scrambled rows
    scrambled = []
    for i, orig in enumerate(ordered_rows):
        new = dict(orig)  # copy structure
        # Replace id with honeypot id (so no real id leaked)
        new["id"] = f"HP-{seed_int % 100000}-{i+1}"
        for f in fields:
            new_val = permuted_columns[f][i]
            # In extreme case where permuted equals original (shouldn't if derangement succeeded), rotate fallback
            if str(new_val) == str(orig.get(f, "")):
                # fallback: pick neighbor value (safe)
                j = (i + 1) % n
                new_val = permuted_columns[f][j]
            new[f] = new_val
        scrambled.append(new)
    return scrambled

# -------------------- Logging (honeypot_access) --------------------
@app.before_request
def log_access():
    # skip static
    if request.path.startswith("/static"):
        return
    sid = request.args.get("sid") or session.get("sid") or str(uuid.uuid4())
    session["sid"] = sid
    try:
        conn = get_hp_db()
        cur = conn.cursor()
        cur.execute("""
            INSERT INTO honeypot_access (sid, ip_address, user_agent, endpoint, method, payload)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (sid, request.remote_addr, request.headers.get("User-Agent",""), request.path, request.method, json.dumps(request.get_json(silent=True) or dict(request.form) or {})))
        conn.commit(); conn.close()
    except Exception as e:
        print("honeypot log error:", e)

# -------------------- Routes --------------------
@app.route("/", methods=["GET"])
def root_fake_dashboard():
    sid = request.args.get("sid") or session.get("sid") or str(uuid.uuid4())
    session["sid"] = sid
    # small preview: take first 12 rows from real DB, scramble them for preview
    real = fetch_real_intel_rows(limit=12)
    if not real:
        preview = []
    else:
        preview = scramble_rows_preserve_values(sid, real)
    honeypot_link = url_for("hp_db", sid=sid)
    return render_template("fake_dashboard.html", rows=preview, sid=sid, honeypot_link=honeypot_link)

@app.route("/honeypot_db")
def hp_db():
    sid = request.args.get("sid") or session.get("sid") or str(uuid.uuid4())
    session["sid"] = sid

    page = int(request.args.get("page", 1))
    PER_PAGE = 200
    offset = (page - 1) * PER_PAGE

    real = fetch_real_intel_rows(limit=PER_PAGE + offset)
    page_rows = real[offset:offset + PER_PAGE]

    scrambled = scramble_rows_preserve_values(sid, page_rows)

    return render_template(
        "honeypot.html",
        rows=scrambled,
        sid=sid,
        page=page,
        next_page=page + 1
    )

@app.route("/search", methods=["POST"])
def hp_search():
    sid = request.args.get("sid") or session.get("sid") or str(uuid.uuid4())
    session["sid"] = sid
    q = (request.form.get("q") or "") if request.form else ""
    try:
        conn = get_hp_db(); cur = conn.cursor()
        cur.execute("INSERT INTO honeypot_searches (sid, ip_address, search_text, params) VALUES (?, ?, ?, ?)",
                    (sid, request.remote_addr, q, json.dumps(dict(request.form))))
        conn.commit(); conn.close()
    except Exception as e:
        print("honeypot search log error:", e)

    # filter locally on the scrambled rows (we'll fetch and scramble again for the search)
    real = fetch_real_intel_rows(limit=None)
    scrambled = scramble_rows_preserve_values(sid, real) if real else scramble_rows_preserve_values(sid, load_fixture())
    if q:
        filtered = [r for r in scrambled if q.lower() in json.dumps(r).lower()]
    else:
        filtered = scrambled
    return render_template("honeypot.html", rows=filtered, sid=sid, q=q)

@app.route("/_logs/recent")
def hp_recent_logs():
    conn = get_hp_db(); cur = conn.cursor()
    cur.execute("SELECT id, sid, ip_address, endpoint, method, created_at FROM honeypot_access ORDER BY id DESC LIMIT 200")
    rows = [dict(r) for r in cur.fetchall()]
    conn.close()
    return jsonify(rows)

# -------------------- helper: fallback fixture & simple scramble for fixtures --------------
def load_fixture():
    p = os.path.join(BASE_DIR, "fake_assets.json")
    if os.path.exists(p):
        with open(p, "r", encoding="utf-8") as fh:
            return json.load(fh)
    # tiny fallback
    return [
        {"id":"HP-1","asset_id":"A-1001","codename":"alpha","affiliation":"Unknown","threat_level":3,"status":"dormant","last_known_location":"Paris","mission_priority":"Low","extraction_needed":0,"reliability_score":6.7},
        {"id":"HP-2","asset_id":"A-1002","codename":"bravo","affiliation":"Unknown","threat_level":5,"status":"active","last_known_location":"Berlin","mission_priority":"Medium","extraction_needed":0,"reliability_score":5.2},
        {"id":"HP-3","asset_id":"A-1003","codename":"charlie","affiliation":"Unknown","threat_level":8,"status":"active","last_known_location":"NYC","mission_priority":"High","extraction_needed":1,"reliability_score":8.9},
    ]
@app.route("/honeypot")
def honeypot_alias():
    return hp_db()

# stub for template links
@app.route("/admin_requests", methods=["GET","POST"])
def admin_requests():
    return "<h3>Admin requests disabled in honeypot</h3>", 200



# -------------------- main --------------------
if __name__ == "__main__":
    init_hp_db()
    app.run(host="127.0.0.1", port=5001, debug=True)
